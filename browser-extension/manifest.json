{
  "manifest_version": 3,
  "name": "BridgeUX Browser Agent",
  "version": "0.1.0",
  "description": "Connect BridgeUX to the active browser tab for local page reading and actions.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:18765/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "BridgeUX", "default_popup": "popup.html"}
}
