{
  "name": "bridgeux",
  "version": "0.1.0",
  "description": "Local-first accessibility support desktop app",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "org.bridgeux.desktop",
    "productName": "BridgeUX",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "bridgeux-mark.svg",
      "bridgeux-logo.svg",
      "index.html",
      "agent-status.html",
      "agent-status.js",
      "styles.css",
      "app.js",
      "local.js",
      "local-screen.js",
      "voice.js",
      "system-captions.js",
      "agent-status.css",
      "caption-overlay.html",
      "caption-overlay.js",
      "voice.css",
      "speech-capture.js",
      "sign-vision.js",
      "asl-phrases.js",
      "gesture-control.js",
      "!browser-extension/**/*",
      "!docs/**/*"
    ],
    "extraResources": [
      {
        "from": "models/asr-nemotron-3.5-560ms-int8",
        "to": "models/asr-nemotron-3.5-560ms-int8",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models/tts",
        "to": "models/tts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models/gesture/gesture_recognizer.task",
        "to": "gesture/gesture_recognizer.task"
      },
      {
        "from": "models/sign",
        "to": "models/sign",
        "filter": ["**/*"]
      },
      {
        "from": "node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.wasm",
        "to": "onnxruntime/ort-wasm-simd-threaded.wasm"
      },
      {
        "from": "browser-extension",
        "to": "browser-extension",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/@mediapipe/tasks-vision/wasm",
        "to": "mediapipe/wasm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/bridgeux.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "onnxruntime-web": "^1.31.1",
    "piper-phonemize-node": "^1.5.9",
    "sherpa-onnx-node": "^2.0.1"
  }
}
